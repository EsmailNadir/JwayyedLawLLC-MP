# Canonical site URL (metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.jjlawohio.com

# Cloudflare Turnstile site key for the contact form's spam check. Public by
# design. The matching SECRET key goes in the Formspree dashboard (form
# settings > CAPTCHA > Cloudflare Turnstile), never here. Local development
# falls back to Cloudflare's always-pass test key when this is unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
